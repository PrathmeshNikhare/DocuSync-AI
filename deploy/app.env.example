# App container only. Placeholders; copy to deploy/app.env (git-ignored).
# The reviewer UI's origin as browsers see it (the private 8444 site, not the
# webhook-only public one); the app sees http:// behind the proxy.
APP_ORIGIN=https://localhost:8444
# The app role, never the owner. Host `postgres` is the compose service.
# Percent-encode the password if it contains URL characters (@ : / ? # % and so on).
DATABASE_URL=postgres://docusync_app:REPLACE_APP_DB_PASSWORD@postgres:5432/docusync
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_INSTALLATION_IDS=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Off unless exactly "true"; set up the rulesets in docs/10 first.
GITHUB_WRITES_ENABLED=false
GITHUB_APP_SLUG=
# Optional model: start the `model` profile and pull a model first.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ALLOW_INSECURE_HTTP=true
OLLAMA_MODEL=
