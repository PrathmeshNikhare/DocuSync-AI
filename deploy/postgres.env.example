# Postgres container only. Placeholders; copy to deploy/postgres.env.
POSTGRES_USER=docusync
# The bootstrap superuser: used by the init scripts only. Never put it in migrate.env or app.env.
POSTGRES_PASSWORD=REPLACE_ADMIN_DB_PASSWORD
POSTGRES_DB=docusync
# docusync_owner: owns the database, runs migrations. Not a superuser.
OWNER_DB_PASSWORD=REPLACE_OWNER_DB_PASSWORD
APP_DB_PASSWORD=REPLACE_APP_DB_PASSWORD
