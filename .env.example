# Copy to .env.local for local development. Never commit real secrets.
# Passwords below are the local Docker Compose placeholders (db/init/01-app-role.sql).
# If you set POSTGRES_HOST_PORT (read by docker compose from .env), use that port here.

# App runtime: least-privilege role (rows only, no DDL).
DATABASE_URL=postgres://docusync_app:change-me-app-local-only@localhost:5432/docusync
# Migrations only (npm run db:migrate): schema owner.
MIGRATION_DATABASE_URL=postgres://docusync:change-me-local-only@localhost:5432/docusync
# Database tests (npm run test:db) use a separate database.
TEST_DATABASE_URL=postgres://docusync_app:change-me-app-local-only@localhost:5432/docusync_test
TEST_MIGRATION_DATABASE_URL=postgres://docusync:change-me-local-only@localhost:5432/docusync_test

# GitHub App (read-only in Phase 01). Not needed for fixture mode.
GITHUB_WEBHOOK_SECRET=
# Comma-separated installation ids allowed to queue work; the webhook fails closed (503) without it.
# 987654 is the installation id in fixtures/webhooks/pull_request.opened.json.
GITHUB_ALLOWED_INSTALLATION_IDS=
GITHUB_APP_ID=
# PEM on one line with literal \n escapes, or a quoted multi-line value.
GITHUB_APP_PRIVATE_KEY=

# Later phases.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
