{
  "name": "docusync-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --project db",
    "test:ollama": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --project ollama",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "ingest": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/ingest.ts",
    "analyze": "node --import tsx scripts/analyze.ts",
    "eval:impact": "node --import tsx scripts/eval-impact.ts",
    "propose": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/propose.ts",
    "eval:llm": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/eval-llm.ts",
    "analysis:run": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/analysis-run.ts",
    "reviewer:add": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/reviewer.ts add",
    "reviewer:grant": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/reviewer.ts grant",
    "reviewer:unlock": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/reviewer.ts unlock",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
